<div class="container d-flex justify-content-center align-items-center mb-4">
  <form action="/otziv" method="POST" class="p-4 border rounded shadow bg-light" style="max-width: 600px; width: 100%;">
    <div class="row g-3">
      <div class="col-md-6">
        <input type="text" name="name" placeholder="Имя" class="form-control" required>
      </div>
      <div class="col-md-6">
        <input type="email" name="email" placeholder="E-mail" class="form-control" required>
      </div>
      <div class="col-12">
        <textarea name="text" placeholder="Текст отзыва" class="form-control" rows="4" required></textarea>
      </div>
      <div class="col-12 text-center">
        <button type="submit" class="btn btn-dark px-5">Оставить отзыв</button>
      </div>
    </div>
  </form>
</div>
