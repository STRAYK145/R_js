<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
</head>

<body class="container">
    <header>
        <%- include('../partials/header'); %>
    </header>
    <main>
        <div class="p-5 mb-4 bg-secondary rounded-3">
            <h1>Добро пожаловать в Базу знаний для туристов!</h1>
            <p>Узнай больше о красивейших местах России!</p>
        </div>
        <div class="container my-5">
            <h2 class="text-center mb-4">Популярные города для путешествий:</h2>
            <div class="row g-4">
                <% goroda.forEach(function(gorod) { %>
                    <div class="col-md-4">
                        <div class="card h-100 shadow">
                            <div class="ratio ratio-16x9">
                                <img src="<%= gorod.put %>" class="w-100 h-100 object-fit-cover rounded-top"
                                    alt="Страхование грузов">
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title"><%= gorod.name %></h5>
                                <p class="card-text"><%= gorod.info %></p>
                                <div class="d-flex justify-content-center mt-auto">
                                    <a href="product.html" class="btn btn-dark" style="width: 250px;">Подробнее</a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
        <div>
            <%- include('../partials/form'); %>
        </div>
    </main>
    <footer>
        <p class="text-center text-muted">Сайт создал ст.гр.ИРспк-223 Маринин А.А.</p>
    </footer>
</body>

</html>